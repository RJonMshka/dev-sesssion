{
	"name": "dev-sesssion",
	"version": "1.0.2",
	"license": "MIT",
	"type": "module",
	"bin": {
		"dev-sesssion": "dist/index.cjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"prepack": "cp ../../README.md README.md"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.54.0",
		"@clack/prompts": "1.2.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"clipboardy": "4.0.0",
		"commander": "14",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@dev-session/adapters": "workspace:*",
		"@dev-session/core": "workspace:*",
		"@dev-session/security": "workspace:*"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
